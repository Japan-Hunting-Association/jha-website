---
import Layout from '@/layouts/_layout.astro';
---

<Layout title="404 - ページが見つかりません | 日本狩猟協会">
    <main class="container mx-auto px-4 pt-36 pb-16">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-6xl font-bold mb-8">404</h1>
            <p class="text-2xl text-gray-600 mb-8">
                ページが見つかりません
            </p>
            <p class="text-gray-600 mb-8">
                お探しのページは移動または削除された可能性があります。
            </p>
            <a href="/" class="inline-block px-6 py-3 bg-orange text-white rounded hover:bg-orange/90 transition-colors">
                トップページに戻る
            </a>
        </div>
    </main>
</Layout>