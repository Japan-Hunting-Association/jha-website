---
import Layout from "@/layouts/_layout.astro";
import { Image } from "astro:assets";
// import logo from "@/assets/logo.svg";
import image_problem_1 from "@/assets/problem1.jpg";
import image_problem_2 from "@/assets/problem2.jpg";
import image_problem_3 from "@/assets/problem3.jpg";
import image_hunter_community from "@/assets/hunter-community.jpg";
import image_hunter_house from "@/assets/hunter-house.jpg";
import image_hunter_tech from "@/assets/hunter-tech.jpg";
import image_hunter_knowledge from "@/assets/hunter-knowledge.jpg";
import image_hunter_store from "@/assets/hunter-store.jpg";
// import heroImage from "@/assets/sample.jpg";

const problems = [
  {
    title: "高齢化による人材不足",
    description: "狩猟人口の高齢化に伴う地方ハンターの激減",
    image: image_problem_1,
    icon: "👴"
  },
  {
    title: "旧態依然な体制",
    description: "旧態依然なハンターとお役所の有害鳥獣事業",
    image: image_problem_2,
    icon: "🏛️"
  },
  {
    title: "IT化の遅れ",
    description: "IT化の遅れによる狩猟技術のシェアリング不足",
    image: image_problem_3,
    icon: "💻"
  }
];

const services = [
  {
    title: "Hunter Community",
    description: "ハンター同士が情報交換したり交流できるコミュニティスペース",
    image: image_hunter_community
  },
  {
    title: "Hunter House",
    description: "ハンターが利用できる短期滞在・賃貸物件の紹介サービス",
    image: image_hunter_house
  },
  {
    title: "Hunter Tech",
    description: "IoTやマイコンを駆使した狩猟技術のテック化プロジェクト",
    image: image_hunter_tech
  },
  {
    title: "Hunter Knowledge",
    description: "狩猟技術の保存とシェアを目指すドキュメントスペース",
    image: image_hunter_knowledge
  },
  {
    title: "Hunter Store",
    description: "ジビエ素材の利活用を促進するためのマーケットサービス",
    image: image_hunter_store
  }
];
---

<Layout title="日本狩猟協会について | 日本狩猟協会">
  <!-- ミッションセクション -->
  <section class="pt-36 pb-24 px-8 bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <div class="text-xs tracking-wider text-gray-500 mb-4">OUR MISSION</div>
        <h2 class="text-3xl font-light tracking-wide mb-8">私たちの使命</h2>
      </div>
      
      <div class="space-y-8 text-center">
        <p class="text-lg text-gray-600 leading-relaxed">
          日本狩猟協会は、日本の狩猟環境をアップデートするために有志で結成された狩猟団体です。
        </p>
        <p class="text-lg text-gray-600 leading-relaxed">
          テクノロジーの導入や官民一体となった行政システムのチューニングによって、<br />
          停滞している狩猟環境に革新をもたらします。
        </p>
        <p class="text-xl font-medium text-gray-800">
          それが日本狩猟協会の存在意義であり、ミッションです。
        </p>
      </div>
    </div>
  </section>

  <!-- 課題セクション -->
  <section class="py-24 px-8 bg-gray-50">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <div class="text-xs tracking-wider text-gray-500 mb-4">CHALLENGES</div>
        <h2 class="text-3xl font-light tracking-wide mb-8">解決すべき課題</h2>
        <p class="text-gray-600 mb-8">日本の狩猟環境が直面している3つの大きな課題</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-gray-100">
        {problems.map((problem) => (
          <div class="group bg-white overflow-hidden hover:bg-gray-50 transition-colors duration-300">
            <div class="relative h-48 overflow-hidden">
              <Image
                src={problem.image}
                alt={problem.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="p-8">
              <h3 class="text-xl font-light mb-3">{problem.title}</h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                {problem.description}
              </p>
            </div>
          </div>
        ))}
      </div>
      
      <div class="text-center mt-12">
        <p class="text-lg text-gray-700">
          これらの問題は、待っているだけでは何も変わりません。<br />
          <strong>だれかが「アップデート」する必要があるのです。</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- 5つの事業セクション -->
  <section class="py-24 px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <div class="text-xs tracking-wider text-gray-500 mb-4">OUR SERVICES</div>
        <h2 class="text-3xl font-light tracking-wide mb-8">5つの事業展開</h2>
        <p class="text-gray-600">日本狩猟協会は以下の五事業を提供し、日本の狩猟環境のアップデートに挑戦します</p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-gray-100">
        {services.slice(0, 3).map((service) => (
          <div class="group bg-white overflow-hidden hover:bg-gray-50 transition-colors duration-300">
            <div class="relative h-64 overflow-hidden">
              <Image
                src={service.image}
                alt={service.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            
            <div class="p-8">
              <h3 class="text-xl font-light mb-3">{service.title}</h3>
              <p class="text-sm text-gray-600">
                {service.description}
              </p>
            </div>
          </div>
        ))}
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-gray-100 mt-px">
        {services.slice(3).map((service) => (
          <div class="group bg-white overflow-hidden hover:bg-gray-50 transition-colors duration-300">
            <div class="relative h-64 overflow-hidden">
              <Image
                src={service.image}
                alt={service.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            
            <div class="p-8">
              <h3 class="text-xl font-light mb-3">{service.title}</h3>
              <p class="text-sm text-gray-600">
                {service.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 私たちが解決すること -->
  <section class="py-24 px-8 bg-gray-50">
    <div class="max-w-4xl mx-auto text-center">
      <div class="text-xs tracking-wider text-gray-500 mb-4">WHAT WE SOLVE</div>
      <h2 class="text-3xl font-light tracking-wide mb-8">私たちが解決すること</h2>
      
      <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-12">
        <div class="text-center">
          <div class="text-3xl mb-2">🏠</div>
          <p class="text-sm text-gray-600">拠点がない</p>
        </div>
        <div class="text-center">
          <div class="text-3xl mb-2">👥</div>
          <p class="text-sm text-gray-600">仲間がいない</p>
        </div>
        <div class="text-center">
          <div class="text-3xl mb-2">📊</div>
          <p class="text-sm text-gray-600">市場がない</p>
        </div>
        <div class="text-center">
          <div class="text-3xl mb-2">📚</div>
          <p class="text-sm text-gray-600">情報がない</p>
        </div>
        <div class="text-center">
          <div class="text-3xl mb-2">⚡</div>
          <p class="text-sm text-gray-600">効率的でない</p>
        </div>
      </div>
      
      <p class="text-lg text-gray-700 leading-relaxed">
        われわれの活動を通じて、<br />
        すこしでも日本の狩猟環境が前進することがあれば幸いです。
      </p>
    </div>
  </section>

  <!-- CTAセクション -->
  <section class="py-16 px-8 bg-orange text-white">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-light mb-6">一緒に狩猟業界をアップデートしませんか？</h2>
      <p class="text-lg mb-8 opacity-90">
        日本狩猟協会は同じ価値観を共に活動してくれる仲間（会員）を募集しています。
      </p>
      <a
        href="/join"
        class="inline-block bg-white text-orange px-8 py-3 hover:bg-gray-100 transition-colors duration-300 font-medium"
      >
        会員募集について詳しく見る
      </a>
    </div>
  </section>
</Layout>