---
import Layout from "@/layouts/_layout.astro";
---

<Layout title="お問い合わせ | 日本狩猟協会">
    <main class="container mx-auto px-4 pt-36 pb-16">
        <div class="max-w-4xl mx-auto">
            <h1 class="text-4xl font-bold mb-8">お問い合わせ</h1>
            
            <div class="prose prose-lg max-w-none">
                <p class="text-gray-600">
                    お問い合わせは、<a
                        href="https://x.com/hunters_japan"
                        target="_blank"
                        class="text-orange hover:underline">X(旧twitter)</a
                    >
                    もしくは<a
                        href="https://discord.gg/7d9e5r8sae"
                        target="_blank"
                        class="text-orange hover:underline">Discord</a
                    >
                    のDMまでお願いします。<br />
                    電話番号やメールアドレスは公開しておりません。ご了承ください。
                </p>
            </div>
        </div>
    </main>
</Layout>