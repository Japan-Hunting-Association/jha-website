---
import Layout from "@/layouts/_layout.astro";
---

<Layout title="活動報告 | 日本狩猟協会">
  <main class="container mx-auto px-4 pt-36 pb-16">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold mb-8">活動報告</h1>
      
      <div class="prose prose-lg max-w-none">
        <p class="text-gray-600 mb-8">
          日本狩猟協会の活動実績と成果をご報告いたします。
        </p>

        <section class="mb-12">
          <h2 class="text-2xl font-semibold mb-6">年次報告書</h2>
          
          <div class="space-y-4">
            <div class="border rounded-lg p-6 hover:bg-gray-50 transition-colors">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-lg font-medium">2024年度 活動報告書</h3>
                <span class="text-sm text-gray-500">2024年発行</span>
              </div>
              <p class="text-gray-600 mb-3">
                2024年度の活動実績について
              </p>
              <a href="/reports/annual_activity_report_2024.pdf" target="_blank" class="text-orange hover:underline">PDFダウンロード →</a>
            </div>

            <div class="border rounded-lg p-6 hover:bg-gray-50 transition-colors">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-lg font-medium">2024年度 財務報告書</h3>
                <span class="text-sm text-gray-500">2024年発行</span>
              </div>
              <p class="text-gray-600 mb-3">
                2024年度の財務状況について
              </p>
              <a href="/reports/annual_financial_report_2024.pdf" target="_blank" class="text-orange hover:underline">PDFダウンロード →</a>
            </div>

            <div class="border rounded-lg p-6 hover:bg-gray-50 transition-colors">
              <div class="flex justify-between items-start mb-2">
                <h3 class="text-lg font-medium">2024年度 総会議事録</h3>
                <span class="text-sm text-gray-500">2024年発行</span>
              </div>
              <p class="text-gray-600 mb-3">
                2024年度総会の議事録
              </p>
              <a href="/reports/annual_general_meeting_2024.pdf" target="_blank" class="text-orange hover:underline">PDFダウンロード →</a>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>