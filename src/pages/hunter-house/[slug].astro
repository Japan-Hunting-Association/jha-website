---
import Layout from "@/layouts/_layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import defaultHeroImage from "@/assets/sample.jpg";

// Import specific hero images
import yubariTownImage from "@/content/house/img/yubari/yubari_town.jpg";

export async function getStaticPaths() {
    const pages = await getCollection("house");

    const paths = pages.map((page) => {
        return {
            params: { slug: page.slug },
            props: page,
        };
    });

    return paths;
}

const post: any = Astro.props;
const { Content } = await post.render();

// Add URL variables
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://www.japan-hunting-association.or.jp';
const coverURL = post.data.cover 
    ? new URL(post.data.cover, siteUrl).toString()
    : '/ogp/default.jpg';
const pageURL = Astro.url;

// Add basic variables with template literal
const pageTitle = `${post.data.name} | ハンターハウス`;
const description = post.data.description;

// Get location display - use new structured fields or fallback to old format
const getLocationDisplay = () => {
    // Use new structured fields if available
    if (post.data.prefecture && post.data.city) {
        return `${post.data.prefecture}${post.data.city}`;
    }
    
    // Fallback to old format (remove postal code from address)
    if (!post.data.address) return '';
    const parts = post.data.address.split(' ');
    if (parts.length > 1) {
        return parts.slice(1).join(' ');
    }
    return post.data.address;
};
const locationDisplay = getLocationDisplay();

// Get full address - use structured fields or fallback
const getFullAddress = () => {
    // Use new structured fields if available
    if (post.data.postalCode && post.data.prefecture) {
        return `〒${post.data.postalCode} ${post.data.prefecture}${post.data.city}${post.data.addressDetail}`;
    }
    // Fallback to old format
    return post.data.address || '';
};
const fullAddress = getFullAddress();

// Select hero image based on slug
let heroImage: any = defaultHeroImage;
// Check if this is the yubari page
if (post.slug && post.slug.includes('yubari')) {
    heroImage = yubariTownImage;
}
---

<Layout 
    title={pageTitle}
    description={description}
    imageUrl={coverURL}
    pageURL={pageURL}
>
    <main>
        <!-- Hero Section -->
        <section class="relative h-[50vh] min-h-[400px] flex items-center justify-center overflow-hidden" style="margin-top: 80px;">
            <div class="absolute inset-0">
                {/* Use cover image if available, otherwise use default hero image */}
                <Image
                    src={heroImage}
                    alt={post.data.name}
                    class="w-full h-full object-cover"
                />
                <div class="absolute inset-0 bg-black bg-opacity-50"></div>
            </div>
            
            <div class="relative z-10 text-center px-8 max-w-4xl mx-auto">
                <nav class="text-sm text-white opacity-80 mb-6">
                    <a href="/" class="hover:text-white transition-colors">ホーム</a>
                    <span class="mx-2 text-white">&gt;</span>
                    <a href="/hunter-house" class="hover:text-white transition-colors">ハンターハウス</a>
                    <span class="mx-2 text-white">&gt;</span>
                    <span class="text-white">{post.data.name}</span>
                </nav>
                <h1 class="text-4xl md:text-5xl font-light text-white mb-4 tracking-wide">{post.data.name}</h1>
                <p class="text-lg text-white opacity-90">{post.data.description}</p>
            </div>
        </section>

        <!-- Quick Info Bar -->
        <section class="bg-white border-b border-gray-200">
            <div class="max-w-7xl mx-auto px-8 py-6">
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-sm">
                    <div>
                        <span class="text-gray-500">料金</span>
                        <p class="font-medium text-gray-900">{post.data.price}</p>
                    </div>
                    <div>
                        <span class="text-gray-500">管理人</span>
                        <p class="font-medium text-gray-900">{post.data.owner}</p>
                    </div>
                    <div>
                        <span class="text-gray-500">所在地</span>
                        <p class="font-medium text-gray-900 text-xs">{locationDisplay}</p>
                    </div>
                    <div>
                        <span class="text-gray-500">最終更新</span>
                        <time datetime={post.data.pubDate?.toISOString()} class="font-medium text-gray-900 block">
                            {new Intl.DateTimeFormat("ja-JP").format(post.data.pubDate)}
                        </time>
                    </div>
                </div>
            </div>
        </section>

        <!-- Main Content -->
        <section class="py-12 px-8 bg-gray-50">
            <div class="max-w-7xl mx-auto">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <!-- Left Column - Main Content -->
                    <div class="lg:col-span-2 space-y-8">
                        <!-- Facility Overview -->
                        <div class="bg-white rounded-lg shadow-sm p-8">
                            <div class="mb-6">
                                <div class="text-xs tracking-wider text-gray-500 mb-2">OVERVIEW</div>
                                <h2 class="text-2xl font-light tracking-wide">施設概要</h2>
                            </div>
                            <div class="prose prose-lg max-w-none text-gray-600">
                                <Content />
                            </div>
                        </div>

                        <!-- Equipment Grid -->
                        { post.data.equipments && post.data.equipments.length > 0 && (
                            <div class="bg-white rounded-lg shadow-sm p-8">
                                <div class="mb-6">
                                    <div class="text-xs tracking-wider text-gray-500 mb-2">EQUIPMENT</div>
                                    <h2 class="text-2xl font-light tracking-wide">設備</h2>
                                </div>
                                <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                    {post.data.equipments.map((equipment: string) => (
                                        <div class="flex items-center p-3 bg-gray-50 rounded-md">
                                            <span class="text-sm text-gray-700">✓ {equipment}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}
                    </div>

                    <!-- Right Column - Sidebar -->
                    <div class="lg:col-span-1">
                        <div class="lg:sticky lg:top-24 space-y-6">
                            <!-- Booking Card -->
                            <div class="bg-white rounded-lg shadow-sm p-6">
                                <h3 class="text-lg font-medium mb-4">予約情報</h3>
                                <div class="space-y-4">
                                    <div>
                                        <p class="text-xs text-gray-500 mb-1">料金</p>
                                        <p class="font-medium text-gray-900">{post.data.price}</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-gray-500 mb-1">予約方法</p>
                                        <p class="text-sm text-gray-700">{post.data.booking}</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-gray-500 mb-1">賃貸について</p>
                                        <p class="text-sm text-gray-700">{post.data.forRent}</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Contact Card -->
                            <div class="bg-white rounded-lg shadow-sm p-6">
                                <h3 class="text-lg font-medium mb-4">お問い合わせ</h3>
                                <div class="space-y-4">
                                    <div>
                                        <p class="text-xs text-gray-500 mb-1">管理人</p>
                                        <p class="font-medium text-gray-900">{post.data.owner}</p>
                                    </div>
                                    <div>
                                        <p class="text-xs text-gray-500 mb-1">連絡先</p>
                                        <a
                                            href={post.data.contact}
                                            class="text-orange hover:opacity-80 transition-opacity text-sm break-all"
                                            target="_blank"
                                        >
                                            {post.data.contact}
                                        </a>
                                    </div>
                                </div>
                                <a
                                    href={post.data.contact}
                                    target="_blank"
                                    class="mt-6 w-full bg-orange text-white py-3 px-4 text-sm text-center block hover:opacity-90 transition-opacity duration-200"
                                >
                                    お問い合わせする
                                </a>
                            </div>

                            <!-- Tags -->
                            { post.data.tags && post.data.tags.length > 0 && (
                                <div class="bg-white rounded-lg shadow-sm p-6">
                                    <h3 class="text-lg font-medium mb-4">タグ</h3>
                                    <div class="flex flex-wrap gap-2">
                                        { post.data.tags.map((tag: string) => (
                                            <span class="inline-block px-3 py-1 text-xs text-gray-600 border border-gray-300 rounded-full">
                                                {tag}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Access Section -->
        { post.data.map_embed && (
            <section class="py-12 px-8 bg-white">
                <div class="max-w-7xl mx-auto">
                    <div class="mb-6">
                        <div class="text-xs tracking-wider text-gray-500 mb-2">ACCESS</div>
                        <h2 class="text-2xl font-light tracking-wide mb-4">アクセス</h2>
                        <p class="text-gray-600">{fullAddress}</p>
                    </div>
                    <div class="rounded-lg overflow-hidden shadow-md">
                        <iframe
                            src={post.data.map_embed}
                            class="w-full h-[400px] md:h-[500px]"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                        ></iframe>
                    </div>
                </div>
            </section>
        )}

        <!-- CTA Section -->
        <section class="py-12 px-8 bg-gray-50">
            <div class="max-w-4xl mx-auto text-center">
                <a 
                    href="/hunter-house" 
                    class="inline-block px-8 py-3 bg-white border border-gray-300 text-gray-700 text-sm tracking-wider hover:bg-gray-50 transition-colors duration-200"
                >
                    ハンターハウス一覧に戻る
                </a>
            </div>
        </section>
    </main>
</Layout>
