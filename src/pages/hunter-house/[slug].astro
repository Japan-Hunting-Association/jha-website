---
import Layout from "@/layouts/_layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import heroImage from "@/assets/sample.jpg";

export async function getStaticPaths() {
    const pages = await getCollection("house", ({ id }) => {
        return id.startsWith("ja/");
    });

    const paths = pages.map((page) => {
        const [lang, ...slug] = page.slug.split("/");
        return {
            params: { lang, slug: slug.join("/") || undefined },
            props: page,
        };
    });

    return paths;
}

const post: any = Astro.props;
const { Content } = await post.render();

// Add URL variables
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://www.japan-hunting-association.or.jp';
const coverURL = post.data.cover 
    ? new URL(post.data.cover, siteUrl).toString()
    : '/ogp/default.jpg';
const pageURL = Astro.url;

// Add basic variables with template literal
const pageTitle = `${post.data.name} | ハンターハウス`;
const description = post.data.description;
---

<Layout 
    title={pageTitle}
    description={description}
    imageUrl={coverURL}
    pageURL={pageURL}
>
    <main class="pt-36">
        <!-- Minimal test content -->
        <div class="max-w-4xl mx-auto px-8">
            <h1 class="text-3xl font-bold mb-4">{post.data.name}</h1>
            <p class="text-gray-600 mb-8">{post.data.description}</p>
        </div>

        <!-- Hero Section commented out for debugging -->
        {/* 
        <section class="relative h-[50vh] min-h-[400px] flex items-center justify-center overflow-hidden" style="margin-top: 80px;">
