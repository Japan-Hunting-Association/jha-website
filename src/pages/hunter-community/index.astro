---
import Layout from "@/layouts/_layout.astro";
import { Image } from "astro:assets";
import img_union_facebook from "@/assets/online-hunter-union/online-hunter-union-facebook.jpg";
import img_union_discord from "@/assets/online-hunter-union/online-hunter-union-discord.jpg";
import communityStats from "@/data/community-stats.json";

const communities = [
    {
        platform: 'Facebook',
        name: 'オンライン猟遊会 Facebookグループ',
        icon: 'ph ph-facebook-logo',
        image: img_union_facebook,
        members: `${communityStats.facebook}名`,
        description: '全国のハンターが集まる情報交換の場',
        features: [
            '狩猟の最新情報共有',
            'イベント・講習会の告知',
            '地域別の情報交換',
            '狩猟の成果報告'
        ],
        url: 'https://www.facebook.com/share/ZU28pn7NwZk5jadD/',
        buttonText: 'Facebookグループに参加',
        color: 'bg-blue-600 hover:bg-blue-700'
    },
    {
        platform: 'Discord',
        name: 'オンライン猟遊会 Discordサーバー',
        icon: 'ph ph-discord-logo',
        image: img_union_discord,
        members: `${communityStats.discord}名`,
        description: 'リアルタイムで交流できるチャットサーバー',
        features: [
            '初心者向け相談チャンネル',
            '地域別交流チャンネル',
            'ボイスチャット対応',
            '画像・動画の共有'
        ],
        url: 'https://discord.gg/7d9e5r8sae',
        buttonText: 'Discordサーバーに参加',
        color: 'bg-indigo-600 hover:bg-indigo-700'
    }
];

const benefits = [
    {
        icon: '🎯',
        title: '最新の狩猟情報',
        description: '法改正や規制情報をいち早くキャッチ'
    },
    {
        icon: '👥',
        title: '全国のハンターと交流',
        description: '経験豊富なハンターから初心者まで幅広く交流'
    },
    {
        icon: '📚',
        title: '初心者歓迎',
        description: '質問・相談はいつでもOK、みんなで成長'
    },
    {
        icon: '🗓️',
        title: 'イベント情報',
        description: '講習会や交流会の最新情報をお届け'
    }
];

const faqs = [
    {
        question: '参加費用はかかりますか？',
        answer: 'いいえ、FacebookグループもDiscordサーバーも完全無料でご参加いただけます。'
    },
    {
        question: '狩猟免許を持っていなくても参加できますか？',
        answer: 'はい、狩猟に興味がある方であれば、どなたでも参加可能です。これから免許取得を考えている方も歓迎します。'
    },
    {
        question: 'どちらか一方だけの参加でも大丈夫ですか？',
        answer: 'もちろん大丈夫です。FacebookとDiscordそれぞれ異なる特徴がありますので、お好みに合わせてご参加ください。'
    }
];
---

<Layout title="ハンターコミュニティ | 日本狩猟協会">
    <main class="pt-20">
        <!-- ヒーローセクション -->
        <section class="bg-gradient-to-b from-gray-50 to-white py-20">
            <div class="container mx-auto px-4">
                <div class="max-w-4xl mx-auto text-center">
                    <h1 class="text-5xl font-bold mb-6">
                        全国のハンターと繋がろう
                    </h1>
                    <p class="text-xl text-gray-600 mb-8">
                        日本狩猟協会が運営する「オンライン猟遊会」は、<br />
                        全国のハンターが集まる<strong class="text-orange">{communityStats.total}名</strong>の成長中のコミュニティです
                    </p>
                    <div class="flex flex-wrap gap-4 justify-center">
                        <div class="bg-white px-6 py-3 rounded-full shadow-sm">
                            <span class="text-gray-600">メンバー数</span>
                            <strong class="text-2xl ml-2">{communityStats.total}</strong>
                        </div>
                        <div class="bg-white px-6 py-3 rounded-full shadow-sm">
                            <span class="text-gray-600">プラットフォーム</span>
                            <strong class="text-2xl ml-2">2</strong>
                        </div>
                        <div class="bg-white px-6 py-3 rounded-full shadow-sm">
                            <span class="text-gray-600">参加費</span>
                            <strong class="text-2xl ml-2 text-green-600">無料</strong>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- コミュニティカード -->
        <section class="py-20">
            <div class="container mx-auto px-4">
                <div class="max-w-6xl mx-auto">
                    <h2 class="text-3xl font-bold text-center mb-12">参加方法を選ぶ</h2>
                    
                    <div class="grid md:grid-cols-2 gap-8">
                        {communities.map((community) => (
                            <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                                <!-- 画像セクション -->
                                <div class="relative h-64 bg-gray-200">
                                    <Image
                                        src={community.image}
                                        alt={community.name}
                                        class="w-full h-full object-cover"
                                    />
                                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                                    <div class="absolute bottom-4 left-4 text-white">
                                        <div class="flex items-center gap-2 mb-2">
                                            <i class={`${community.icon} text-3xl`}></i>
                                            <span class="text-2xl font-bold">{community.platform}</span>
                                        </div>
                                        <div class="text-sm opacity-90">メンバー {community.members}</div>
                                    </div>
                                </div>
                                
                                <!-- コンテンツセクション -->
                                <div class="p-6">
                                    <h3 class="text-xl font-bold mb-2">{community.name}</h3>
                                    <p class="text-gray-600 mb-4">{community.description}</p>
                                    
                                    <ul class="space-y-2 mb-6">
                                        {community.features.map((feature) => (
                                            <li class="flex items-start gap-2 text-sm text-gray-600">
                                                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                                </svg>
                                                {feature}
                                            </li>
                                        ))}
                                    </ul>
                                    
                                    <a
                                        href={community.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class={`block w-full text-center text-white py-3 px-6 rounded-lg font-bold transition-colors ${community.color}`}
                                    >
                                        {community.buttonText}
                                    </a>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- 参加メリット -->
        <section class="py-20 bg-gray-50">
            <div class="container mx-auto px-4">
                <div class="max-w-4xl mx-auto">
                    <h2 class="text-3xl font-bold text-center mb-12">コミュニティ参加のメリット</h2>
                    
                    <div class="grid md:grid-cols-2 gap-6">
                        {benefits.map((benefit) => (
                            <div class="bg-white p-6 rounded-lg shadow-sm hover:shadow-md transition-shadow">
                                <div class="flex items-start gap-4">
                                    <span class="text-3xl">{benefit.icon}</span>
                                    <div>
                                        <h3 class="font-bold mb-2">{benefit.title}</h3>
                                        <p class="text-gray-600 text-sm">{benefit.description}</p>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ -->
        <section class="py-20">
            <div class="container mx-auto px-4">
                <div class="max-w-3xl mx-auto">
                    <h2 class="text-3xl font-bold text-center mb-12">よくある質問</h2>
                    
                    <div class="space-y-4">
                        {faqs.map((faq) => (
                            <div class="bg-white p-6 rounded-lg shadow-sm">
                                <h3 class="font-bold mb-2 flex items-start gap-2">
                                    <span class="text-orange">Q.</span>
                                    {faq.question}
                                </h3>
                                <p class="text-gray-600 ml-6">
                                    <span class="text-gray-400">A.</span> {faq.answer}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="py-20 bg-orange text-white">
            <div class="container mx-auto px-4 text-center">
                <h2 class="text-3xl font-bold mb-4">今すぐコミュニティに参加しよう</h2>
                <p class="text-xl mb-8">
                    全国のハンターと情報交換・交流を始めましょう
                </p>
                <div class="flex flex-wrap gap-4 justify-center">
                    <a
                        href="https://www.facebook.com/share/ZU28pn7NwZk5jadD/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="bg-white text-blue-600 px-8 py-3 rounded-lg font-bold hover:bg-gray-100 transition-colors"
                    >
                        <i class="ph ph-facebook-logo mr-2"></i>
                        Facebookで参加
                    </a>
                    <a
                        href="https://discord.gg/7d9e5r8sae"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="bg-white text-indigo-600 px-8 py-3 rounded-lg font-bold hover:bg-gray-100 transition-colors"
                    >
                        <i class="ph ph-discord-logo mr-2"></i>
                        Discordで参加
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>