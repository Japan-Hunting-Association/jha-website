---
const featuredPrograms = [
  {
    id: 1,
    name: "狩猟安全講習プログラム",
    duration: "3日間",
    category: "安全教育",
    image: "/images/safety-training.jpg",
    features: ["オンライン事前学習", "実技研修", "認定証発行"],
    isNew: false,
    isRecommended: true
  },
  {
    id: 2,
    name: "デジタル野生動物管理システム",
    duration: "継続利用",
    category: "ITソリューション",
    image: "/images/digital-management.jpg",
    features: ["リアルタイム追跡", "データ分析", "レポート生成"],
    isNew: true,
    isRecommended: false
  },
  {
    id: 3,
    name: "森林管理会議",
    duration: "年2回開催",
    category: "業界交流",
    image: "/images/forest-conference.jpg",
    features: ["専門家講演", "ネットワーキング", "最新技術紹介"],
    isNew: false,
    isRecommended: false
  }
];
---

<section class="py-24 px-8 bg-white">
  <div class="max-w-full mx-auto">
    <div class="mb-20">
      <div class="text-xs tracking-wider text-gray-500 mb-4">PROGRAMS</div>
      <h2 class="text-3xl font-light tracking-wide">注目のプログラム</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-gray-100">
      {featuredPrograms.map((program) => (
        <div class="group bg-white overflow-hidden">
          <div class="relative">
            {/* バッジ */}
            <div class="absolute top-4 left-4 z-10 flex gap-2">
              {program.isNew && (
                <span class="bg-black text-white px-3 py-1 text-xs tracking-wider">
                  NEW
                </span>
              )}
              {program.isRecommended && (
                <span class="bg-orange text-white px-3 py-1 text-xs tracking-wider">
                  おすすめ
                </span>
              )}
            </div>

            {/* プレースホルダー画像 */}
            <div class="h-64 bg-gray-200 relative overflow-hidden">
              <div class="w-full h-full flex items-center justify-center text-gray-400">
                <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            </div>
          </div>
          
          <div class="p-8">
            <div class="text-xs text-gray-500 mb-2">{program.category}</div>
            <h3 class="text-lg font-light mb-2">{program.name}</h3>
            <div class="text-sm text-gray-600 mb-6">期間: {program.duration}</div>
            
            <ul class="space-y-2 mb-8">
              {program.features.map((feature) => (
                <li class="text-xs text-gray-500 flex items-center">
                  <svg class="w-4 h-4 mr-2 text-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
            
            <button class="w-full border border-gray-300 py-2 text-sm hover:bg-gray-50 transition-colors duration-200">
              詳細を見る
            </button>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 text-center">
      <a
        href="/ja/join"
        class="inline-block border border-gray-800 text-gray-800 px-8 py-3 hover:bg-gray-800 hover:text-white transition-all duration-300 text-sm tracking-wider"
      >
        すべてのプログラムを見る
      </a>
    </div>
  </div>
</section>