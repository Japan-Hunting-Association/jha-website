---
const categories = [
  {
    id: 1,
    title: "IT活用推進",
    description: "デジタル技術で業界を革新",
    image: "/images/tech-innovation.jpg",
    items: ["データ管理システム", "狩猟記録アプリ", "個体数調査支援"]
  },
  {
    id: 2,
    title: "野生動物管理",
    description: "科学的根拠に基づく保護活動",
    image: "/images/wildlife-management.jpg",
    items: ["個体数モニタリング", "生息地調査", "被害対策支援"]
  },
  {
    id: 3,
    title: "教育・研修",
    description: "次世代への技術継承",
    image: "/images/education-training.jpg",
    items: ["オンライン講習", "安全研修", "技術講習会"]
  }
];
---

<section class="py-24 px-8 bg-white">
  <div class="max-w-full mx-auto">
    <div class="mb-20">
      <div class="text-xs tracking-wider text-gray-500 mb-4">ACTIVITIES</div>
      <h2 class="text-3xl font-light tracking-wide mb-8">協会の主な活動内容</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-gray-100">
      {categories.map((category) => (
        <div class="group bg-white overflow-hidden hover:bg-gray-50 transition-colors duration-300">
          <div class="relative h-80 overflow-hidden bg-gray-200">
            <div class="w-full h-full flex items-center justify-center text-gray-400">
              {/* プレースホルダー画像 */}
              <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
          </div>
          
          <div class="p-8">
            <h3 class="text-xl font-light mb-3">{category.title}</h3>
            <p class="text-sm text-gray-600 mb-6">{category.description}</p>
            
            <ul class="space-y-2 mb-8">
              {category.items.map((item) => (
                <li class="text-xs text-gray-500 flex items-center">
                  <span class="w-1 h-1 bg-gray-400 rounded-full mr-2"></span>
                  {item}
                </li>
              ))}
            </ul>
            
            <a href="#" class="text-xs tracking-wider text-gray-800 hover:text-black transition-colors duration-200">
              詳細を見る →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>