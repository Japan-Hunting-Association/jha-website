---
import { getBaseURL } from '@/util/url';
import { Image } from 'astro:assets';
const { house_data } = Astro.props;
---

<a 
  href={ `/hunter-house/${getBaseURL(house_data.slug)}` } 
  class="group block bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-shadow duration-300"
>
  <!-- Image Container -->
  <div class="relative overflow-hidden aspect-[5/2]">
    <Image
      src={ house_data.data.cover }
      alt={ house_data.data.name }
      width={house_data.data.coverWidth}
      height={house_data.data.coverHeight}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
    />
    <!-- NEW Badge -->
    <div class="absolute top-4 left-4">
      <span class="bg-orange text-white px-3 py-1 text-xs font-medium tracking-wider">
        NEW
      </span>
    </div>
  </div>
  
  <!-- Content -->
  <div class="p-6">
    <!-- Title -->
    <h3 class="text-xl font-medium mb-2 text-gray-900 group-hover:text-orange transition-colors">
      { house_data.data.name }
    </h3>
    
    <!-- Description -->
    <p class="text-sm text-gray-600 mb-4 line-clamp-2">
      { house_data.data.description }
    </p>
    
    <!-- Tags -->
    { house_data.data.tags && house_data.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        { house_data.data.tags.map((tag: string) => (
          <span class="inline-block px-2 py-1 text-xs text-gray-600 border border-gray-300 rounded-md">
            { tag }
          </span>
        ))}
      </div>
    )}
  </div>
</a>