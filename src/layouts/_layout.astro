---
import '@/styles/global.css'
import '@/styles/globals.css'
import { Header } from '@/components/base/Header'
import Footer from '@/components/base/footer.astro'

const title = Astro.props.title ?? "一般社団法人日本狩猟協会";
const twitterHandle = Astro.props.twitterHandle ?? "@hunters_japan";
const description = Astro.props.description ?? "日本狩猟協会は、狩猟をアップデートする一般社団法人です。";
const imageUrl = Astro.props.imageUrl ?? 'https://www.japan-hunting-association.or.jp/ogp/card_hd.jpg';
const pageURL = Astro.props.pageURL ?? 'https://www.japan-hunting-association.or.jp/';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico">
		<link rel="icon" type="image/png" sizes="32x32" href="/icon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/icon-16x16.png">
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
		<link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">
		<link rel="manifest" href="/manifest.json">

		<meta name="generator" content={Astro.generator} />

		<title>{ title }</title>

		<link
		rel="stylesheet"
		type="text/css"
		href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css"
		/>

		<meta property="og:title" content={ title } />
		<meta property="og:description" content={ description } />
		<meta property="og:image" content={ imageUrl } />
		<meta property="og:url" content={ pageURL } />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="一般社団法人日本狩猟協会" />
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:site" content={ twitterHandle }>
		<meta name="twitter:title" content={ title }>
		<meta name="twitter:description" content={ description }>
		<meta name="twitter:image" content={ imageUrl }>
		<astro:language-switcher />
	</head>
	<body>
		<Header client:load />
		<slot />
		<Footer />
	</body>
</html>